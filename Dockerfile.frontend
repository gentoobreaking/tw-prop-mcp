# Frontend Dockerfile — React + TypeScript + Google Maps
# Served by nginx with /healthz endpoint for k8s probes
# Build args:
#   VITE_GOOGLE_MAPS_API_KEY — from .env (Google Maps JS API key)
#   VITE_MCP_SERVER_URL — defaults to /mcp (proxied by nginx)
# VITE_* env vars are statically embedded by Vite at build time.
FROM node:20-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_GOOGLE_MAPS_API_KEY
ARG VITE_MCP_SERVER_URL=/mcp
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY
ENV VITE_MCP_SERVER_URL=$VITE_MCP_SERVER_URL
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist/ /usr/share/nginx/html/
COPY frontend/nginx.conf /etc/nginx/nginx.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
