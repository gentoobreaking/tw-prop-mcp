# Frontend Dockerfile — React + TypeScript + Maps
# Served by nginx with /healthz endpoint for k8s probes
# Build args:
#   VITE_GOOGLE_MAPS_API_KEY — from .env (Google Maps JS API key)
# Runtime env (via runtime-config.js):
#   MCP_SERVER_URL — MCP server URL (default: /mcp)
#   MAP_PROVIDER — 'google' | 'leaflet' (default: leaflet)
FROM node:20-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_GOOGLE_MAPS_API_KEY
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY
# Build with placeholder; runtime values injected via runtime-config.js
RUN VITE_MCP_SERVER_URL=http://localhost:8080/mcp npm run build

FROM nginx:alpine

# Install gettext for envsubst
RUN apk add --no-cache gettext

# Copy built frontend
COPY --from=builder /app/dist/ /usr/share/nginx/html/

# Custom entrypoint hook: generate runtime-config.js at container start
COPY --chmod=755 <<'EOF' /docker-entrypoint.d/15-runtime-config.sh
#!/bin/sh
MCP_URL="${MCP_SERVER_URL:-/mcp}"
MAP_PROVIDER="${MAP_PROVIDER:-leaflet}"
echo "window.RUNTIME_CONFIG = {
  \"MCP_SERVER_URL\": \"${MCP_URL}\",
  \"MAP_PROVIDER\": \"${MAP_PROVIDER}\"
};" > /usr/share/nginx/html/runtime-config.js
EOF

# Copy nginx config
COPY frontend/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
