# Copy to .env and fill in real values.
# .env is git-ignored (secrets must never be committed).

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=prop
POSTGRES_PASSWORD=prop_dev_only
POSTGRES_DB=prop

# ── MCP Server ───────────────────────────────────────────
DATABASE_URL=postgresql://prop:prop_dev_only@tw-prop-postgres:5432/prop
MCP_TRANSPORT=http
MCP_HTTP_ADDR=:8080
LOG_LEVEL=info

# ── Auto Refresh (docker-compose up 自動檢查新鮮度，1/11/21 發布，週末順延 3 天窗口) ───────
AUTO_REFRESH_ENABLED=true
DATA_FRESHNESS_DAYS=10
DATA_REFRESH_INTERVAL=6h
DATA_IMPORT_URL=
AUTO_DISCOVER=true

# ── Frontend ───────────────────────────────────────────────
# Build-time (Vite): Google Maps JS API key (optional if MAP_PROVIDER=leaflet)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

MCP_SERVER_URL=/mcp  # Runtime config for frontend
MAP_PROVIDER=leaflet  # or 'google' (requires valid GOOGLE_MAPS_API_KEY)
