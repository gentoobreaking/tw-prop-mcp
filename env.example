# Copy to .env and fill in real values.
# .env is git-ignored (secrets must never be committed).

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=prop
POSTGRES_PASSWORD=prop_dev_only
POSTGRES_DB=prop

# ── MCP Server ───────────────────────────────────────────
DATABASE_URL=postgresql://prop:prop_dev_only@tw-prop-postgres:5432/prop
MCP_TRANSPORT=http
MCP_HTTP_ADDR=:8080
LOG_LEVEL=info

# ── Frontend (Vite build-time env vars) ─────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_MCP_SERVER_URL=/mcp
