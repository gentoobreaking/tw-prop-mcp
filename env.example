# Copy to .env and fill in real values.
# .env is git-ignored (secrets must never be committed).

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=prop
POSTGRES_PASSWORD=prop_dev_only
POSTGRES_DB=prop

# ── MCP Server ───────────────────────────────────────────
DATABASE_URL=postgresql://prop:prop_dev_only@tw-prop-postgres:5432/prop
MCP_TRANSPORT=http
MCP_HTTP_ADDR=:8080
LOG_LEVEL=info

# ── Frontend ───────────────────────────────────────────────
# Build-time (Vite): Google Maps JS API key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here


GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here  # Optional at build, required if MAP_PROVIDER=google

MCP_SERVER_URL=/mcp  # Runtime config for frontend
MAP_PROVIDER=leaflet  # or 'google' (requires valid GOOGLE_MAPS_API_KEY)

